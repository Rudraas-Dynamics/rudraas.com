# ---- App ----
NODE_ENV=development
PORT=4000

# ---- MongoDB ----
MONGODB_URI=mongodb://career_api:changeme@mongo:27017/careers?authSource=careers

# ---- JWT ----
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-a-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cookies / CSRF ----
COOKIE_SECRET=replace-with-a-random-secret

# ---- CORS ----
CORS_ORIGINS=https://rudraas.com,https://career.rudraas.com
PUBLIC_WEB_ORIGIN=https://rudraas.com
ADMIN_WEB_ORIGIN=https://career.rudraas.com

# ---- Object storage (S3 or MinIO) ----
STORAGE_DRIVER=s3
# Leave S3_ENDPOINT unset for AWS S3; set it to the MinIO endpoint (e.g. http://minio:9000) for self-hosted storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=rudraas-career-resumes
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
# Optional CDN/CloudFront domain fronting the bucket for resume downloads
RESUME_CDN_BASE_URL=

# ---- SMTP / Email ----
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=replace-me
SMTP_FROM="Rudraas Careers <careers@rudraas.com>"
HR_NOTIFICATION_EMAILS=hr@rudraas.com
ADMIN_NOTIFICATION_EMAILS=admin@rudraas.com

# ---- Virus scanning (ClamAV) ----
VIRUS_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10
THROTTLE_APPLY_LIMIT=5

# ---- Initial admin bootstrap (used only by `npm run seed`) ----
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@rudraas.com
SEED_ADMIN_PASSWORD=change-this-immediately-after-first-login
