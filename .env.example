# ---------------------------------------------------------------------------
# Careers Portal (docker-compose)
# ---------------------------------------------------------------------------
# These are top-level variables read directly by the root docker-compose.yml
# (Mongo/MinIO admin credentials + the Vite build-time API URL). They are
# separate from, and do not replace, each app's own env file:
#   careers-portal/backend/.env.example
#   careers-portal/admin-frontend/.env.example
#
# Copy this file to `.env` at the repo root and fill in real values before
# running `docker compose up`.

# ---- MongoDB root/admin credentials (used by the `mongo` compose service) ----
# Local/dev only: career-api's MONGODB_URI (see careers-portal/backend/.env)
# points directly at these root credentials for simplicity. In production,
# point MONGODB_URI at a properly provisioned MongoDB (Atlas or a
# self-managed replica set) with its own user/IAM setup done out-of-band -
# see docs/DEPLOYMENT.md.
MONGO_ROOT_USERNAME=changeme
MONGO_ROOT_PASSWORD=changeme

# ---- MinIO root credentials (used by the `minio` and `minio-init` services) ----
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# ---- Admin SPA build-time API URL ----
# Baked into the career-admin static bundle at IMAGE BUILD TIME via the
# VITE_API_BASE_URL build ARG (Vite inlines VITE_* vars at build time, not
# at container runtime) - see careers-portal/admin-frontend/Dockerfile.
ADMIN_API_BASE_URL=https://career.rudraas.com/api/v1

# ---------------------------------------------------------------------------
# Rudraas marketing site (this Next.js app)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` at the repo root for `next dev`/`next build`.
# Read by lib/career-api.ts and lib/career-application.ts to talk to the
# careers-portal backend's public endpoints from /career and /career/[slug].
NEXT_PUBLIC_CAREER_API_BASE_URL=https://career.rudraas.com/api/v1
# Local backend during development:
# NEXT_PUBLIC_CAREER_API_BASE_URL=http://localhost:4000/api/v1
